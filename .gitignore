# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行时状态 ----
# 状态目录：元数据库、知识库、结果缓存
data/
!data/.gitkeep
*.db
*.db-journal
*.sqlite3

# ---- 多项目工作台数据（M7）----
# 每个项目一个目录：project.toml / secrets.json（本地凭据）/ state/（任务库、缓存）
# 用户数据与口令绝不入库
projects/
# pnpm 离线 store（本地依赖缓存，可由 package.json 还原）
.pnpm-store/

# ---- 本地配置与凭据 ----
# 绝不入库：连接配置、凭据引用、本地覆盖
.env
.env.*
local.toml
*.local.yaml

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 前端 ----
# 依赖与构建产物都不入库：前者可由 package.json 还原，后者由 npm run build 产出
node_modules/
apps/web/frontend/dist/
.npm-cache/
npm-debug.log*
*.tsbuildinfo

# ---- 附件 ----
# 题库原件与只读副本不入库
~$*.xlsx

# ---- 本地设计技能（第三方，仅本机使用）----
# impeccable skill 从上游仓库复制安装，工具链产物不并入本项目代码
.dsh/skills/
impeccable-main/

# ---- 参考材料 ----
# 第三方范本只用于阅读对照，不是本项目代码（MIT，原仓库 obra/superpowers）
superpowers-main/
# LangChain 官方源码：作为「开箱即用的集成 agent」参考阅读，不并入本项目
langchain-master/

# ---- 日志 ----
*.log

# ---- 临时文件 ----
# 提交消息、一次性脚本：写了就删，不该入库
_*.tmp
_tmp/

